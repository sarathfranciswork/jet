events {
}

http {
    sendfile on;

    server {
        listen 80;
        root /www/data/;
        access_log /var/log/nginx/access.log;

        client_max_body_size ${FILE_SIZE_LIMIT};

        add_header X-Content-Type-Options    "nosniff" always;
        add_header Referrer-Policy           "no-referrer-when-downgrade" always;
        add_header Permissions-Policy        "interest-cohort=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # Landing page at /landing
        location /landing {
            alias /www/landing/;
            index index.html;
            try_files $uri $uri/ /landing/index.html;
        }

        location /landing/css/ {
            alias /www/landing/css/;
        }

        location /landing/js/ {
            alias /www/landing/js/;
        }

        location /landing/images/ {
            alias /www/landing/images/;
        }

        # Web app
        location / {
            proxy_pass http://web:3000/;
        }

        location /api/ {
            proxy_pass http://api:8000/api/;
        }

        location /spaces/ {
            rewrite ^/spaces/?$ /spaces/login break;
            proxy_pass http://space:3000/spaces/;
        }

        location /${BUCKET_NAME}/ {
            proxy_pass http://jet-minio:9000/uploads/;
        }
    }
}
